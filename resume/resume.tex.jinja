\documentclass[a4paper,10.5pt]{article}

\usepackage[margin=0.65in]{geometry}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage{xcolor}

\definecolor{darkblue}{RGB}{20,20,20}
\hypersetup{colorlinks=true, urlcolor=darkblue, linkcolor=darkblue}

\pagestyle{empty}
\setlength{\parindent}{0pt}

\titleformat{\section}{\large\bfseries\scshape}{}{0em}{}[\titlerule]
\titlespacing{\section}{0pt}{10pt}{6pt}

\newcommand{\resumeItem}[1]{\item #1}
\newenvironment{resumeItemize}{\begin{itemize}[leftmargin=*, itemsep=1pt, topsep=2pt]}{\end{itemize}}

\newcommand{\resumeProject}[3]{
  \textbf{#1} \hfill \textit{#2} \\
  \textit{Tech Stack: #3}
}

\begin{document}

% ---------- HEADER ----------
\begin{center}
    {\LARGE \textbf{((( personal.name )))}} \\[2pt]
    ((( personal.title ))) \\[2pt]
    ((( personal.location ))) $\vert$ ((( personal.phone ))) $\vert$ \href{mailto:((( personal.email )))}{((( personal.email )))} \\
    \href{((( personal.github )))}{((( personal.github_display )))} $\vert$ \href{((( personal.linkedin )))}{((( personal.linkedin_display )))} $\vert$ \href{((( personal.portfolio )))}{((( personal.portfolio_display )))}
\end{center}

% ---------- SUMMARY ----------
\section*{Professional Summary}
((( summary )))

% ---------- EDUCATION ----------
\section*{Education}
((* for edu in education *))
\textbf{((( edu.degree )))} \hfill ((( edu.period ))) \\
((( edu.institution ))) \hfill ((( edu.score ))) \\
\textit{((( edu.notes )))}
((* endfor *))

% ---------- TECHNICAL SKILLS ----------
\section*{Technical Skills}
\begin{resumeItemize}
((* for skill in skills *))
    \resumeItem{\textbf{((( skill.category ))):} ((( skill.items )))}
((* endfor *))
\end{resumeItemize}

% ---------- PROJECTS ----------
\section*{Featured Projects}

((* for proj in projects *))
\resumeProject{((( proj.title )))}{((( proj.platform )))}{((( proj.tech_stack )))}
\begin{resumeItemize}
((* for bullet in proj.bullets *))
    \resumeItem{((( bullet )))}
((* endfor *))
\end{resumeItemize}
\vspace{4pt}

((* endfor *))

\section*{Technical Experience}
\begin{resumeItemize}
((* for exp in experience *))
((* for bullet in exp.bullets *))
    \resumeItem{((( bullet )))}
((* endfor *))
((* endfor *))
\end{resumeItemize}

% ---------- LANGUAGES ----------
\section*{Languages}
((( languages | join(' \\quad $\\vert$ \\quad ') )))

\end{document}
